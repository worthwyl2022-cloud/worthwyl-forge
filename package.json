{
  "name": "worthwyl-studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/tsx/dist/cli.mjs server.ts",
    "build": "node ./node_modules/vite/bin/vite.js build && ./node_modules/.bin/esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist",
    "lint": "node ./node_modules/typescript/bin/tsc --noEmit",
    "test": "npm run lint && npm run audit:architecture",
    "audit:architecture": "bash scripts/audit-architecture.sh",
    "android:test": "cd android && ./gradlew test --no-daemon",
    "android:assemble": "cd android && ./gradlew assembleDebug --no-daemon"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.8",
    "express": "^5.2.1",
    "lucide-react": "^1.54.0",
    "motion": "^14.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^26.6.5",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.28.2",
    "nanoid": "^6.0.2",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.15",
    "typescript": "~5.8.2",
    "vite": "^8.3.4",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  }
}
